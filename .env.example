# Local Node server. Production: set the actual HTTPS origin.
ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://studio:studio_local@localhost:5433/studio
# Generate once: openssl rand -hex 32. Keep stable and backed up separately from DB.
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client (Web application). Never use PUBLIC_ prefixes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated verified Google email addresses permitted to sign in.
AUTH_ALLOWED_EMAILS=
# Callback URL registered with Google must be ORIGIN + /auth/google/callback.
# For npm run dev, set ORIGIN=http://localhost:5173 and use that URL consistently.

# Google Ads API developer token (server only)
GOOGLE_ADS_DEVELOPER_TOKEN=
