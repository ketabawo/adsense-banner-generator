{
  "name": "adsense-banner-generator",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "overrides": {
    "cookie": "0.7.2"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "npm run build && node --env-file-if-exists=.env.deploy scripts/deploy.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "basic-ftp": "^6.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "idb": "^8.0.3"
  }
}
